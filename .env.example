# MotoLinker — environment variables
#
# Every variable the server actually reads, grouped by what stops working
# without it. Copy to .env for local work; on Railway these go in the service's
# Variables tab.
#
# README step 3 has told people to copy this file since the beginning and the
# file did not exist, so the tracking settings in particular lived only in chat
# messages. Generated from the code (grep for process.env), not from memory.
#
# Only the REQUIRED block is needed to boot. Everything else degrades: the
# feature it belongs to reports itself unconfigured rather than failing.

# ─── Required ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The service_role key, not the anon key. Every table has RLS enabled with no
# policies, so the anon key reaches nothing and the app would read empty tables.
SUPABASE_SERVICE_KEY=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
PORT=3000
# Used in emails and push notifications to link back here. No trailing slash.
APP_URL=https://your-app.up.railway.app

# ─── Container tracking ──────────────────────────────────────────────────────
# Which carrier platform answers "where is my box". One of:
#   safecube    Sinay's Safecube. Returns the milestones AND the vessel position
#               in one response, so no separate AIS vendor is needed.
#   terminal49  Terminal49. Reads need a paid plan; the free key may only
#               register containers.
#   generic     Any vendor with a GET-by-container-number URL (see _URL below).
# Leave empty to keep tracking manual — entering the card by hand is supported,
# not a fallback.
CONTAINER_TRACKING_PROVIDER=safecube
CONTAINER_TRACKING_KEY=

# generic provider only: {container} is replaced with the number.
CONTAINER_TRACKING_URL=
# Which header carries the key, and what goes in front of it. Vendors disagree —
# API_KEY, x-api-key, apikey, Authorization: Bearer — and getting it wrong looks
# exactly like a wrong key. Leave both empty for the provider's default; the
# Test connection button in Inventory → Tracking tries every shape against your
# live key and tells you which one to set.
#   safecube   default API_KEY, no prefix
#   terminal49 default Authorization with prefix "Token "
#   generic    default Authorization, no prefix
CONTAINER_TRACKING_HEADER=
CONTAINER_TRACKING_AUTH_PREFIX=
# What to call the provider in the `source` column. Defaults to its name.
CONTAINER_TRACKING_NAME=

# safecube only: the POST /shipments/search body, with {container} substituted.
# Defaults to {"containerNumbers":["{container}"]}. Override without a deploy if
# their API wants a different shape.
SAFECUBE_SEARCH_BODY=
# terminal49 only: the JSON:API filter parameter. Defaults to filter[number].
CONTAINER_TRACKING_FILTER=

# Push instead of polling. Generate a long random string, put it here, then
# register https://<APP_URL>/api/webhooks/<provider>/<this value> in the
# vendor's dashboard. TERMINAL49_WEBHOOK_SECRET is the older name and still
# works, so an already-registered webhook survives a deploy.
TRACKING_WEBHOOK_SECRET=
TERMINAL49_WEBHOOK_SECRET=

# ─── Vessel position (AIS) ───────────────────────────────────────────────────
# ONLY needed when the carrier feed does not carry positions — Safecube does, so
# with safecube above this whole block stays empty. {imo} and {mmsi} are both
# substituted; vendors index on either.
AIS_TRACKING_URL=
AIS_TRACKING_KEY=
AIS_TRACKING_HEADER=
# Recorded in position_source so a fix can be traced back to who supplied it.
AIS_TRACKING_NAME=

# ─── Google (Drive, Calendar, Gmail, Chat) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CHAT_ENABLED=
GOOGLE_CHAT_CLIENT_ID=
GOOGLE_CHAT_CLIENT_SECRET=
GOOGLE_CHAT_READ=

# ─── Website inventory (read-only picker) ────────────────────────────────────
# A SECOND Supabase project — the marketing site's — read for the vehicle picker
# in lead and quotation forms. Separate from the CRM database above.
INVENTORY_SUPABASE_URL=
INVENTORY_SUPABASE_KEY=
INVENTORY_TABLE=vehicles
INVENTORY_NAME_COL=
INVENTORY_PRICE_COL=
INVENTORY_IMAGE_COL=
INVENTORY_GALLERY_COL=
INVENTORY_SUBTITLE_COLS=
INVENTORY_SEARCH_COLS=

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Huddles (WebRTC) ────────────────────────────────────────────────────────
# Without a TURN relay, huddles only connect between people on the same network.
# The relay chip in a chat header reports which of those two you have.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_TOKEN=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Push notifications ──────────────────────────────────────────────────────
# Generated on first boot and stored if absent; set them to keep subscriptions
# working across a database reset. scripts/generate-vapid.js makes a pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Help bot ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Off unless this is exactly 'true'. Needs a writable session path and a browser.
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_PATH=
PUPPETEER_EXECUTABLE_PATH=

# ─── Scheduling ──────────────────────────────────────────────────────────────
# Hour (UTC) the "log your hours" reminder goes out.
HOURS_REMINDER_UTC_HOUR=
