{
  "name": "motolinker-task-bot",
  "version": "1.0.0",
  "private": true,
  "description": "MotoLinker Slack Task Management Bot \u2014 Chiefs assign, teams execute.",
  "main": "index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "npm run build --workspaces --if-present",
    "test": "bash tests/run.sh",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p packages/contracts && tsc -p src/http && tsc -p src/modules && npm run typecheck -w apps/web",
    "test:web": "npm test -w apps/web"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "undici": "^6.29.0",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": "22.x"
  }
}
