{
  "name": "@motolinker/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one web app for the admin and team portals (Vite + React + TypeScript). Built by `npm run build`, served by the Node server behind the ml_ui switch.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@motolinker/contracts": "*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
